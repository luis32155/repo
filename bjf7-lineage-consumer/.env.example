# MongoDB local. Spring Boot usa estos mismos valores por defecto.
# Docker Compose lee .env; para cambiar los valores del proceso Java,
# configura tambien estas variables en el entorno o en IntelliJ.
MONGODB_URI=mongodb://localhost:27017/lineage_audit?retryWrites=false
MONGODB_DATABASE=lineage_audit
MONGODB_COLLECTION=tapp_audit_events
MONGODB_APPLICATION_CODE=TAPP
MONGODB_RETENTION_DAYS=365
