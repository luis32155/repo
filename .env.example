# Portable host settings. No credentials here.
COMPOSE_PROJECT_NAME=cvd-local
BIND_ADDRESS=127.0.0.1
JAVA_MEMORY_LIMIT=512m
JAVA_HEAP_MAX=256m
JAVA_CPU_LIMIT=1.0
# Optional corporate root CA (one X.509 certificate, PEM or DER).
# Empty default file means use the JDK's standard public CAs.
BUILD_CA_FILE=./docker/empty-ca.crt
# If your corporate CA is in the project root, use:
# BUILD_CA_FILE=./corporate-root-ca.cer
GATEWAY_PORT=8080
CONFIG_SERVER_PORT=8888
LOGIN_PORT=8084
TOKEN_GENERATOR_PORT=8086
TOKEN_VALIDATOR_PORT=8087
AUTHORIZER_PORT=8088
MAINTENANCE_PORT=8089
CARDS_PORT=8090
PUBLICATIONS_PORT=8091
PRODUCTS_PORT=8092
